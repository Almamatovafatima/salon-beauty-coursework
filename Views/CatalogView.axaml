<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="Ktpt.CourseOrder.Views.CatalogView"
             Tag="Каталог услуг салона красоты">
	<DockPanel>
		<!-- Верхняя часть: заголовок, поиск, категория, сортировка, счётчик. -->
		<StackPanel DockPanel.Dock="Top" Spacing="8">
			<TextBlock Classes="heading" Text="Каталог услуг салона красоты" />
			<!-- TextChanged срабатывает при каждом изменении текста. -->
			<TextBox x:Name="SearchBox" PlaceholderText="Поиск по названию или коду"
					 TextChanged="SearchChanged" />
			<!-- Grid из трёх столбцов: категория (*), сортировка (250), кнопка (Auto). -->
			<Grid ColumnDefinitions="*,250,Auto" Margin="0,0,0,8">
				<ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch"
						  SelectionChanged="FilterChanged" />
				<ComboBox x:Name="SortBox" Grid.Column="1" HorizontalAlignment="Stretch"
						  SelectionChanged="FilterChanged">
					<ComboBoxItem Content="Цена по возрастанию" />
					<!-- индекс 0 -->
					<ComboBoxItem Content="Цена по убыванию" />
					<!-- индекс 1 -->
				</ComboBox>
				<Button Grid.Column="2" Content="Обновить" Click="ReloadClick" />
			</Grid>
			<TextBlock x:Name="CountText" />
		</StackPanel>
		<!-- Список карточек. ItemsSource заполняется из C# объектами CourseCard. -->
		<ListBox x:Name="CardsList" SelectionChanged="CardSelected">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5,0,5">
						<Grid ColumnDefinitions="150,*,150">
							<!-- Картинка -->
							<Image Source="{Binding Image}" Width="140" Height="120" Stretch="Uniform" />

							<!-- Описание -->
							<StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="5">
								<!-- Меняем ServiceName на Name -->
								<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
								<!-- Меняем CategoryName на Category -->
								<TextBlock Text="{Binding Category}" />
							</StackPanel>

							<!-- Цена -->
							<!-- Меняем BasePrice на PriceText (или Price) -->
							<TextBlock Grid.Column="2" Text="{Binding PriceText}"
									   FontWeight="Bold" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" />
						</Grid>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>				
	</DockPanel>
</UserControl>
